rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Client reads: school email only. No client writes; writes happen
    // exclusively via the Admin SDK inside the Vercel Cron function.
    match /days/{dayId} {
      allow read: if request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@example-school\\.org$');
      allow write: if false;
    }
    match /meta/{docId} {
      allow read: if request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@example-school\\.org$');
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
