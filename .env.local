# --- Client (Firebase web config; safe to expose) ---
NEXT_PUBLIC_FIREBASE_API_KEY=dummy-key-for-emulator
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-ls-dash.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-ls-dash

# --- Emulator wiring (dev only; unset/empty in production) ---
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9090
NEXT_PUBLIC_FIREBASE_FIRESTORE_EMULATOR_HOST=127.0.0.1:8081
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9090
FIRESTORE_EMULATOR_HOST=127.0.0.1:8081
FIREBASE_PROJECT_ID=demo-ls-dash

# --- Server only (never NEXT_PUBLIC_) ---
# Dev value only. Production: random 16+ chars, also set in Vercel env.
CRON_SECRET=dev-only-secret-change-in-prod
ICAL_URL=https://www.lakesideschool.org/calendar/calendar_436.ics
SAGE_LUNCH_MENU_ID=139455
SAGE_BREAKFAST_MENU_ID=138778
