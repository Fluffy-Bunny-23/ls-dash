# Copy to .env.local and fill in. See README deployment section.
# The committed defaults are generic placeholders — any consistent set works
# for local dev; a real deployment sets the school's values here (dev) or in
# the hosting provider's env (prod). Never commit real values.

# --- School identity (NEXT_PUBLIC_ so the client bundle can read them) ---
NEXT_PUBLIC_SCHOOL_DOMAIN=example-school.org
NEXT_PUBLIC_SUPPORT_EMAIL=support@example-school.org

# --- Client (Firebase web config from Firebase console; safe to expose) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# --- Emulator wiring (dev only; leave unset in production) ---
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9090
# NEXT_PUBLIC_FIREBASE_FIRESTORE_EMULATOR_HOST=127.0.0.1:8081
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9090
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8081

# --- Server only (never NEXT_PUBLIC_) ---
# Server-side copy of the school domain (dev-token route, render-rules).
# SCHOOL_DOMAIN=example-school.org
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account", ...}  (Admin SDK JSON)
# FIREBASE_PROJECT_ID=
# CRON_SECRET=<random 16+ chars; Vercel sends it as Bearer on cron invocations>
# ICAL_URL=https://calendar.example-school.org/calendar_abc.ics
# SAGE_LUNCH_MENU_ID=139455
# SAGE_BREAKFAST_MENU_ID=138778
