# Copy to .env.local and fill in. See README deployment section.
# --- Client (Firebase web config from Firebase console; safe to expose) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# --- Emulator wiring (dev only; leave unset in production) ---
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# NEXT_PUBLIC_FIREBASE_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# --- Server only (never NEXT_PUBLIC_) ---
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account", ...}  (Admin SDK JSON)
# FIREBASE_PROJECT_ID=
# CRON_SECRET=<random 16+ chars; Vercel sends it as Bearer on cron invocations>
# ICAL_URL=https://www.example-school.org/calendar/calendar_436.ics
# SAGE_LUNCH_MENU_ID=139455
# SAGE_BREAKFAST_MENU_ID=138778
